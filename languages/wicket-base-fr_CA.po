msgctxt "label"
msgid "Create Account Page"
msgstr "Page de création de compte"

msgid "Choose the create account page. This must contain the \"Create Account Form\" block."
msgstr "Choisissez la page de création de compte. Elle doit contenir le bloc « Create Account Form »."

msgctxt "label"
msgid "New Account Redirect"
msgstr "Redirection après la création du compte"

msgid "Where users are directed once they complete the create account form. Default is /verify-account"
msgstr "Page vers laquelle les utilisateurs sont dirigés une fois le formulaire de création de compte rempli. La valeur par défaut est /verify-account"

msgctxt "label"
msgid "Google Captcha"
msgstr "Google Captcha"

msgid "Enable Google Captcha on Create Account Form"
msgstr "Activer Google Captcha sur le formulaire de création de compte"

msgctxt "label"
msgid "Google Captcha Key"
msgstr "Clé Google Captcha"

msgid "The key used to display Google reCAPTCHA. Obtain a key here <a href=\"https://www.google.com/recaptcha\" target=\"_blank\"> https://www.google.com/recaptcha</a>"
msgstr "Clé utilisée pour afficher Google reCAPTCHA. Obtenez une clé ici : <a href=\"https://www.google.com/recaptcha\" target=\"_blank\"> https://www.google.com/recaptcha</a>"

msgid "Google Captcha Secret Key"
msgstr "Clé secrète Google Captcha"

msgid "The secret key used to display Google reCAPTCHA. Obtain a key here <a href=\"https://www.google.com/recaptcha\" target=\"_blank\"> https://www.google.com/recaptcha</a>"
msgstr "Clé secrète utilisée pour afficher Google reCAPTCHA. Obtenez une clé ici : <a href=\"https://www.google.com/recaptcha\" target=\"_blank\"> https://www.google.com/recaptcha</a>"

msgctxt "label"
msgid "Styles"
msgstr "Styles"

msgctxt "label"
msgid "Disable Default Styling"
msgstr "Désactiver le style par défaut"

msgid "Disable Wicket default styling. Only for advanced users. If you enable this, no styling from this plugin will be loaded. Will be on you to add the necessary styles for all components and blocks."
msgstr "Désactive le style par défaut de Wicket. Réservé aux utilisateurs avancés. Si vous activez cette option, aucun style de cette extension ne sera chargé. Vous devrez ajouter vous-même les styles nécessaires à tous les composants et blocs."

msgid "Connect to Wicket Environments"
msgstr "Se connecter aux environnements Wicket"

msgid "Choose which environment to activate."
msgstr "Choisissez l'environnement à activer."

